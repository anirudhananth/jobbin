{
  "version": "1.0.0",
  "manifest_version": 3,
  "name": "Jobbin",
  "description": "This is a Chrome extension built with React and TypeScript",
  "action": {
    "default_popup": "js/popup.html",
    "default_title": "Jobbin"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "bookmarks",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "*://*.indeed.com/*",
    "*://*.linkedin.com/*",
    "*://*.glassdoor.com/*",
    "*://*.monster.com/*",
    "*://*.careerbuilder.com/*",
    "*://*.simplyhired.com/*",
    "*://*.ziprecruiter.com/*",
    "*://*.usajobs.gov/*",
    "*://*.dice.com/*",
    "*://*.angel.co/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://*.supabase.co/*"
  ],
  "options_page": "js/options.html",
  "background": {
    "service_worker": "js/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*",
        "*://*.glassdoor.com/*",
        "*://*.monster.com/*",
        "*://*.careerbuilder.com/*",
        "*://*.simplyhired.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.usajobs.gov/*",
        "*://*.dice.com/*",
        "*://*.angel.co/*",
        "*://*.wellfound.com/jobs*"
      ],
      "js": [
        "js/contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tailwind.min.css", "*.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
