{
  "version": "1.0.0",
  "manifest_version": 3,
  "name": "React Chrome Extension",
  "description": "This is a Chrome extension built with React and TypeScript",
  "action": {
    "default_popup": "js/popup.html",
    "default_title": "React Chrome Extension"
  },
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.indeed.com/*",
    "*://*.linkedin.com/*",
    "*://*.glassdoor.com/*",
    "*://*.monster.com/*",
    "*://*.careerbuilder.com/*",
    "*://*.simplyhired.com/*",
    "*://*.ziprecruiter.com/*",
    "*://*.usajobs.gov/*",
    "*://*.dice.com/*",
    "*://*.angel.co/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "options_page": "js/options.html",
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*",
        "*://*.glassdoor.com/*",
        "*://*.monster.com/*",
        "*://*.careerbuilder.com/*",
        "*://*.simplyhired.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.usajobs.gov/*",
        "*://*.dice.com/*",
        "*://*.angel.co/*",
        "*://*.stripe.com/jobs*"
      ],
      "js": [
        "js/contentScript.js"
      ]
    }
  ]
}
